{
  "name": "mcp-server-plausible",
  "version": "0.1.0",
  "description": "A strictly-validated, fully tested MCP server for the Plausible Analytics Stats API v2",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-server-plausible": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plausible",
    "analytics",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "@types/node": "^22.20.0"
  },
  "author": "go-ai-now"
}
